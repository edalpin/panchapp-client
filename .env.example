# GraphQL API URL (inlined at build time — set production URL on Railway before deploy)
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:3000/graphql

# Google OAuth (inlined at build time)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Railway only — tells Railpack to serve the Expo export output as an SPA
# RAILPACK_SPA_OUTPUT_DIR=dist
